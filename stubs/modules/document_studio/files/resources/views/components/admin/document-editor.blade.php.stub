@php
    $defaultLabel = $locale === 'fr' 
        ? statictranslations('Document Content (French)') 
        : statictranslations('Document Content (English)');
    $label = $label ?: $defaultLabel;

    $defaultPlaceholder = $locale === 'fr' 
        ? statictranslations('Saisissez le texte du document, ou téléchargez un PDF de remplacement ci-dessous...') 
        : statictranslations('Enter document text, or upload a replacement PDF below...');
    $placeholder = $placeholder ?: $defaultPlaceholder;
@endphp

