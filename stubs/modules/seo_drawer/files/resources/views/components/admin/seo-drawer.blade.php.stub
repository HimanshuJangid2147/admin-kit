@props([
    'model' => null,
    'prefix' => '',
    'slug' => '',
    'defaultTitle' => '',
    'defaultDescription' => '',
])

@php
    $hasPrefix = !empty($prefix);

    $titleNameEn = $hasPrefix ? "{$prefix}[meta_title][en]" : 'meta_title[en]';
    $titleNameRu = $hasPrefix ? "{$prefix}[meta_title][ru]" : 'meta_title[ru]';
    $titleNameKk = $hasPrefix ? "{$prefix}[meta_title][kk]" : 'meta_title[kk]';

    $descNameEn = $hasPrefix ? "{$prefix}[meta_description][en]" : 'meta_description[en]';
    $descNameRu = $hasPrefix ? "{$prefix}[meta_description][ru]" : 'meta_description[ru]';
    $descNameKk = $hasPrefix ? "{$prefix}[meta_description][kk]" : 'meta_description[kk]';

    $titleIdEn = $hasPrefix ? "{$prefix}_meta_title_en" : 'meta_title_en';
    $titleIdRu = $hasPrefix ? "{$prefix}_meta_title_ru" : 'meta_title_ru';
    $titleIdKk = $hasPrefix ? "{$prefix}_meta_title_kk" : 'meta_title_kk';

    $descIdEn = $hasPrefix ? "{$prefix}_meta_description_en" : 'meta_description_en';
    $descIdRu = $hasPrefix ? "{$prefix}_meta_description_ru" : 'meta_description_ru';
    $descIdKk = $hasPrefix ? "{$prefix}_meta_description_kk" : 'meta_description_kk';

    $titleErrorEn = $hasPrefix ? "{$prefix}.meta_title.en" : 'meta_title.en';
    $titleErrorRu = $hasPrefix ? "{$prefix}.meta_title.ru" : 'meta_title.ru';
    $titleErrorKk = $hasPrefix ? "{$prefix}.meta_title.kk" : 'meta_title.kk';

    $descErrorEn = $hasPrefix ? "{$prefix}.meta_description.en" : 'meta_description.en';
    $descErrorRu = $hasPrefix ? "{$prefix}.meta_description.ru" : 'meta_description.ru';
    $descErrorKk = $hasPrefix ? "{$prefix}.meta_description.kk" : 'meta_description.kk';

    $oldTitleEn = $hasPrefix ? old("{$prefix}.meta_title.en") : old('meta_title.en');
    $oldTitleRu = $hasPrefix ? old("{$prefix}.meta_title.ru") : old('meta_title.ru');
    $oldTitleKk = $hasPrefix ? old("{$prefix}.meta_title.kk") : old('meta_title.kk');

    $oldDescEn = $hasPrefix ? old("{$prefix}.meta_description.en") : old('meta_description.en');
    $oldDescRu = $hasPrefix ? old("{$prefix}.meta_description.ru") : old('meta_description.ru');
    $oldDescKk = $hasPrefix ? old("{$prefix}.meta_description.kk") : old('meta_description.kk');

    $modelTitleEn = $model ? ($model->getTranslation('meta_title', 'en', false) ?: '') : '';
    $modelTitleRu = $model ? ($model->getTranslation('meta_title', 'ru', false) ?: '') : '';
    $modelTitleKk = $model ? ($model->getTranslation('meta_title', 'kk', false) ?: '') : '';

    $modelDescEn = $model ? ($model->getTranslation('meta_description', 'en', false) ?: '') : '';
    $modelDescRu = $model ? ($model->getTranslation('meta_description', 'ru', false) ?: '') : '';
    $modelDescKk = $model ? ($model->getTranslation('meta_description', 'kk', false) ?: '') : '';

    $valTitleEn = $oldTitleEn !== null ? $oldTitleEn : $modelTitleEn;
    $valTitleRu = $oldTitleRu !== null ? $oldTitleRu : $modelTitleRu;
    $valTitleKk = $oldTitleKk !== null ? $oldTitleKk : $modelTitleKk;

    $valDescEn = $oldDescEn !== null ? $oldDescEn : $modelDescEn;
    $valDescRu = $oldDescRu !== null ? $oldDescRu : $modelDescRu;
    $valDescKk = $oldDescKk !== null ? $oldDescKk : $modelDescKk;

    $hasErrors = $errors->has($titleErrorEn) || $errors->has($titleErrorRu) || $errors->has($titleErrorKk) ||
                 $errors->has($descErrorEn) || $errors->has($descErrorRu) || $errors->has($descErrorKk);
    $hasCustomSeo = !empty($valTitleEn) || !empty($valTitleRu) || !empty($valTitleKk) ||
                    !empty($valDescEn) || !empty($valDescRu) || !empty($valDescKk);
@endphp

