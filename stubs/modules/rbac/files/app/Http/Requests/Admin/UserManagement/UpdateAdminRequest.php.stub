<?php

namespace App\Http\Requests\Admin\UserManagement;

use App\Http\Requests\Admin\AdminRequest;
use App\Models\Admin;
use Illuminate\Validation\Rule;

class UpdateAdminRequest extends AdminRequest
{
    protected function targetTable(): string
    {
        return 'admin_users';
    }

    public function authorize(): bool
    {
        $admin = $this->adminUser();
        if (! $admin || ! $admin->can('user.update')) {
            return false;
        }

        $id = $this->resolveId();
        if (! $id) {
            return true;
        }

        $targetUser = Admin::find($id);
        if (! $targetUser) {
            return true;
        }

        if ($targetUser->hasRole('super-admin') && ! $admin->hasRole('super-admin')) {
            return false;
        }

        return true;
    }

    public function rules(): array
    {
        $id = $this->resolveId();

        return array_merge($this->idRules(), [
            'name' => ['required', 'string', 'max:255'],
            'email' => [
                'required',
                'string',
                'email',
                'max:255',
                Rule::unique('admin_users', 'email')->ignore($id),
            ],
            'username' => [
                'nullable',
                'string',
                'max:255',
                Rule::unique('admin_users', 'username')->ignore($id),
            ],
            'password' => ['nullable', 'string', 'min:8'],
            'confirmed_password' => ['nullable', 'string', 'min:8', 'same:password'],
            'avatar' => ['nullable', 'image', 'mimes:jpeg,png,jpg,webp,svg', 'max:2048'],
            'phone' => ['nullable', 'string', 'max:30'],
            'is_active' => ['required', 'boolean'],
            'role_ids' => ['required', 'array'],
            'role_ids.*' => ['integer', 'exists:roles,id'],
            'country_ids' => ['nullable', 'array'],
        ]);
    }
}
