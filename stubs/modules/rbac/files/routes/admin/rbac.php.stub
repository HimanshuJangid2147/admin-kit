<?php

use App\Http\Controllers\Admin\RoleController;
use App\Http\Controllers\Admin\UserManagementController;
use Illuminate\Support\Facades\Route;

// Roles Management
Route::prefix('roles')->name('roles.')->group(function () {
    Route::get('/', [RoleController::class, 'index'])->name('index');
    Route::get('/data', [RoleController::class, 'dataTable'])->name('data');
    Route::get('/list', [RoleController::class, 'getRolesList'])->name('list');
    Route::get('/create', [RoleController::class, 'create'])->name('create');
    Route::post('/store', [RoleController::class, 'store'])->name('store');
    Route::get('/edit', [RoleController::class, 'edit'])->name('edit');
    Route::post('/update', [RoleController::class, 'update'])->name('update');
    Route::delete('/delete', [RoleController::class, 'destroy'])->name('delete');
    Route::get('/show', [RoleController::class, 'show'])->name('show');
});

// Users / Team Management
Route::prefix('users')->name('users.')->group(function () {
    Route::get('/', [UserManagementController::class, 'index'])->name('index');
    Route::get('/data', [UserManagementController::class, 'data'])->name('data');
    Route::get('/create', [UserManagementController::class, 'createAdminProfileForm'])->name('create');
    Route::post('/store', [UserManagementController::class, 'storeAdminProfile'])->name('store');
    Route::get('/edit', [UserManagementController::class, 'editAdminProfileForm'])->name('edit');
    Route::post('/update', [UserManagementController::class, 'updateAdminProfile'])->name('update');
    Route::delete('/delete', [UserManagementController::class, 'destroyAdminProfile'])->name('delete');
    Route::get('/show', [UserManagementController::class, 'showAdminProfile'])->name('view');
    Route::match(['post', 'patch'], '/toggle-status', [UserManagementController::class, 'toggleAdminStatus'])->name('toggleStatus');
});
