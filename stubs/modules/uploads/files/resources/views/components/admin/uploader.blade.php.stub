@props([
    'name' => 'staged_uploads[]',
    'altName' => null,
    'multiple' => true,
    'accept' => 'image/*',
    'chunkSizeMb' => 2,
    'concurrent' => 3,
    'label' => 'Drag & Drop files or click to browse',
    'value' => null,
])

@php
    $dotName = str_replace(['[', ']'], ['.', ''], rtrim($name, '[]'));
    $oldVal = old($dotName, $value);
@endphp

<div 
    class="staged-uploader-widget space-y-4"
    data-name="{{ $name }}"
    data-multiple="{{ $multiple ? 'true' : 'false' }}"
    @if($altName) data-alt-name="{{ $altName }}" @endif
    data-chunk-size-mb="{{ $chunkSizeMb }}"
    data-concurrent="{{ $concurrent }}"
>
    <!-- Drop Zone -->
    <div class="staged-drop-zone relative border-2 border-dashed border-border/60 hover:border-primary/60 bg-background/50 hover:bg-primary/5 rounded-2xl py-4 px-4 text-center cursor-pointer transition-all duration-200 group">
        <input 
            type="file" 
            class="staged-file-input hidden" 
            @if($multiple) multiple @endif 
            accept="{{ $accept }}" 
        />
        
        <div class="flex flex-col items-center justify-center space-y-2">
            <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">{{ statictranslations($label) }}</p>
                <p class="text-[10px] text-muted-foreground mt-0.5">{{ statictranslations('Chunked AJAX upload • Automatic retry') }}</p>
            </div>
        </div>
    </div>

    <!-- Progress UI Container -->
    <div class="staged-progress-container"></div>

    <!-- Hidden Inputs Container (holds UUID values for form post) -->
    <div class="staged-hidden-inputs">
        @if ($oldVal && is_string($oldVal))
            <input type="hidden" name="{{ $name }}" value="{{ $oldVal }}">
        @elseif ($oldVal && is_array($oldVal))
            @foreach ($oldVal as $valItem)
                @if (is_string($valItem))
                    <input type="hidden" name="{{ $name }}" value="{{ $valItem }}">
                @endif
            @endforeach
        @endif
    </div>
</div>
