@props([
    'name' => 'pdf',
    'multiple' => false,
    'accept' => 'application/pdf',
    'chunkSizeMb' => 2,
    'concurrent' => 1,
    'profile' => 'document',
    'label' => 'Drag & Drop PDF or click to browse',
])

<div 
    class="staged-uploader-widget space-y-4"
    data-name="{{ $name }}"
    data-multiple="{{ $multiple ? 'true' : 'false' }}"
    data-profile="{{ $profile }}"
    data-chunk-size-mb="{{ $chunkSizeMb }}"
    data-concurrent="{{ $concurrent }}"
>
    <!-- Drop Zone -->
    <div class="staged-drop-zone relative border-2 border-dashed border-border/60 hover:border-primary/60 bg-background/50 hover:bg-primary/5 rounded-2xl py-4 px-4 text-center cursor-pointer transition-all duration-200 group">
        <input 
            type="file" 
            class="staged-file-input hidden" 
            @if($multiple) multiple @endif 
            accept="{{ $accept }}" 
        />
        
        <div class="flex flex-col items-center justify-center space-y-2">
            <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">{{ statictranslations($label) }}</p>
                <p class="text-[10px] text-muted-foreground mt-0.5">{{ statictranslations('Chunked PDF upload • Automatic retry') }}</p>
            </div>
        </div>
    </div>

    <!-- Progress UI Container -->
    <div class="staged-progress-container"></div>

    <!-- Hidden Inputs Container (holds UUID values for form post) -->
    <div class="staged-hidden-inputs"></div>
</div>
