<?php

use App\Http\Controllers\Admin\DashboardController;
use App\Http\Controllers\Admin\TranslationController;
use Illuminate\Support\Facades\Route;

Route::middleware(['web'])
    ->prefix(config('admin.route_prefix', 'admin'))
    ->name(config('admin.route_name_prefix', 'admin.'))
    ->group(function () {
        Route::get('/', [DashboardController::class, 'index'])->name('dashboard');

        Route::post('translations/auto-fill', [TranslationController::class, 'autoFill'])->name('translations.auto-fill');

        foreach (glob(base_path('routes/admin/*.php')) ?: [] as $routeFile) {
            require $routeFile;
        }
    });
