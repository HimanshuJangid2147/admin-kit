    {{-- Fast Inline Theme Sync --}}
    <script>
        (function() {
            const stored = localStorage.getItem('theme') || 'system';
            const isDark = stored === 'dark' || (stored === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();

        @php
            $notificationSoundUrl = null;
            if (class_exists(\App\Models\Setting::class)) {
                try {
                    $globalSiteSettings = \App\Models\Setting::first();
                    $notificationSoundUrl = !empty($globalSiteSettings?->notification_sound)
                        ? \Illuminate\Support\Facades\Storage::disk(config('admin.uploads.disk', 'public'))->url($globalSiteSettings->notification_sound)
                        : null;
                } catch (\Throwable $e) {
                    $notificationSoundUrl = null;
                }
            }
        @endphp

        window.PusherConfig = {
            key: "{{ config('broadcasting.connections.pusher.key') }}",
            cluster: "{{ config('broadcasting.connections.pusher.options.cluster') }}",
            authEndpoint: "{{ url('/broadcasting/auth') }}",
            indexUrl: "{{ \Illuminate\Support\Facades\Route::has('admin.notifications.index') ? route('admin.notifications.index') : '#' }}",
            markReadUrl: "{{ \Illuminate\Support\Facades\Route::has('admin.notifications.mark-as-read') ? route('admin.notifications.mark-as-read') : '#' }}",
            markAllReadUrl: "{{ \Illuminate\Support\Facades\Route::has('admin.notifications.mark-all-read') ? route('admin.notifications.mark-all-read') : '#' }}",
            destroyUrl: "{{ \Illuminate\Support\Facades\Route::has('admin.notifications.destroy') ? route('admin.notifications.destroy') : '#' }}",
            destroyAllUrl: "{{ \Illuminate\Support\Facades\Route::has('admin.notifications.destroy-all') ? route('admin.notifications.destroy-all') : '#' }}",
            soundUrl: @json($notificationSoundUrl),
        };
    </script>

