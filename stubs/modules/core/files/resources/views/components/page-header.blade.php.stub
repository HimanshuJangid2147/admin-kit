@php
    $t = fn ($text) => function_exists('statictranslations') ? statictranslations($text) : __($text);
    $bannerImage = $bannerImage ?? '';
    $isPlaceholder = $isPlaceholder ?? false;
    $bannerRecord = $bannerRecord ?? null;
    $eyebrowText = $eyebrowText ?? '';
    $hasBanner = $hasBanner ?? false;
    $key = $key ?? '';
    $title = $title ?? '';
    $description = $description ?? '';
    $actionRoute = $actionRoute ?? '';
    $actionText = $actionText ?? '';
    $actionIcon = $actionIcon ?? 'plus';
    $actionBtnId = $actionBtnId ?? '';
@endphp

@if ($hasBanner)
    <div class="px-8 pt-8 pb-4 shrink-0">
        <div
            id="page-banner-{{ $key }}"
            class="relative w-full min-h-[140px] md:min-h-[160px] flex flex-col md:flex-row md:items-center justify-between px-8 py-6 bg-cover bg-center rounded-2xl overflow-hidden border border-border/40 shadow-md group transition-all duration-300"
            style="background-image: url('{{ $bannerImage }}');"
        >
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-transparent z-0 pointer-events-none transition-opacity duration-300 group-hover:opacity-90"></div>

            @if ($isPlaceholder)
                <div class="absolute -right-20 -top-20 w-80 h-80 bg-primary/20 rounded-full blur-3xl pointer-events-none z-0"></div>
                <div class="absolute -left-10 -bottom-20 w-72 h-72 bg-accent/15 rounded-full blur-3xl pointer-events-none z-0"></div>
                <div class="absolute inset-0 border border-primary/20 rounded-2xl pointer-events-none z-10"></div>
            @endif

            <div class="relative z-10 max-w-2xl">
                @if (! empty($eyebrowText))
                    <span class="text-[10px] font-sans font-semibold text-accent tracking-[0.2em] uppercase block mb-1">
                        {{ $eyebrowText }}
                    </span>
                @endif
                <h1 class="font-sans font-bold text-2xl md:text-3xl text-white leading-tight drop-shadow-sm">
                    {!! $title !!}
                </h1>
                @if (! empty($description))
                    <p class="text-xs md:text-sm font-sans font-light text-white/75 mt-2 leading-relaxed max-w-xl drop-shadow-sm">
                        {{ $description }}
                    </p>
                @endif
            </div>

            <div class="relative z-10 flex flex-wrap items-center gap-3 mt-4 md:mt-0 shrink-0">
                @if (! empty($actionRoute) && ! empty($actionText))
                    <a
                        href="{{ $actionRoute }}"
                        @if (! empty($actionBtnId)) id="{{ $actionBtnId }}" @endif
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent text-white text-xs font-semibold hover:bg-accent/90 transition-all shadow-sm"
                    >
                        <i class="fa-solid fa-{{ $actionIcon }}"></i>
                        <span>{{ $actionText }}</span>
                    </a>
                @endif
                {{ $slot ?? '' }}
            </div>
        </div>
    </div>
@else
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 px-8 pt-8 pb-4">
        <div>
            @if (! empty($eyebrowText))
                <span class="text-[10px] font-sans font-semibold text-accent tracking-[0.2em] uppercase block mb-1">
                    {{ $eyebrowText }}
                </span>
            @endif
            <h1 class="font-sans font-bold text-2xl md:text-3xl text-foreground tracking-tight">
                {!! $title !!}
            </h1>
            @if (! empty($description))
                <p class="text-xs md:text-sm font-sans text-muted-foreground mt-1">
                    {{ $description }}
                </p>
            @endif
        </div>

        <div class="flex items-center gap-3">
            @if (! empty($actionRoute) && ! empty($actionText))
                <a
                    href="{{ $actionRoute }}"
                    @if (! empty($actionBtnId)) id="{{ $actionBtnId }}" @endif
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-all shadow-sm"
                >
                    <i class="fa-solid fa-{{ $actionIcon }}"></i>
                    <span>{{ $actionText }}</span>
                </a>
            @endif
            {{ $slot ?? '' }}
        </div>
    </div>
@endif
