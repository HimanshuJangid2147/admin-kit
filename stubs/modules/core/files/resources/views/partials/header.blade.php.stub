            title="{{ $t('Toggle Menu') }}"
        >
            <i class="fa-solid fa-bars h-5 w-5"></i>
        </button>

        <div class="flex items-center gap-2 text-xs font-sans text-muted-foreground select-none">
            <span class="font-medium text-foreground">{{ $t('Home') }}</span>
            @hasSection('breadcrumb')
                <i class="fa-solid fa-chevron-right h-3 w-3 shrink-0 opacity-60"></i>
                <span class="font-medium text-foreground">@yield('breadcrumb')</span>
            @endif
        </div>
    </div>

    <div class="flex items-center gap-3.5">

        {{-- Theme Mode Toggle --}}
        <button
            id="header-theme-toggle"
            type="button"
            onclick="window.toggleTheme && window.toggleTheme()"
            class="flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground hover:text-foreground hover:border-primary/40 hover:bg-accent transition-all duration-200 cursor-pointer"
            title="{{ $t('Toggle Theme') }}"
            aria-label="{{ $t('Toggle Theme') }}"
        >
            <i class="fa-solid fa-moon w-4 h-4 hidden dark:block text-accent"></i>
            <i class="fa-solid fa-sun w-4 h-4 block dark:hidden text-accent"></i>
        </button>

        {{-- Notifications Trigger --}}
        <button
            id="notification-trigger"
            class="relative flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground hover:text-foreground hover:border-primary/40 hover:bg-accent transition-all duration-200 cursor-pointer"
            title="{{ $t('Notifications') }}"
            aria-label="{{ $t('Notifications') }}"
        >
            <i class="fa-solid fa-bell w-4 h-4"></i>
            <span id="notification-badge" class="absolute -top-1 -right-1 flex h-4 min-w-[16px] px-1 items-center justify-center rounded-full bg-accent text-[9px] font-sans font-semibold text-white select-none animate-pulse hidden">0</span>
        </button>

        {{-- Language Switcher (if multiple locales enabled) --}}
        @if (count($supportedLocales) > 1)
            <div class="relative" x-data="{ open: false }">
                <button
                    type="button"
                    class="flex h-11 items-center gap-2 px-3 rounded-lg border border-border bg-card text-xs font-medium text-foreground hover:border-primary/40 transition-colors"
                    onclick="this.nextElementSibling.classList.toggle('hidden')"
                >
                    <i class="fa-solid fa-globe text-muted-foreground"></i>
                    <span class="uppercase font-bold">{{ $currentLocale }}</span>
                    <i class="fa-solid fa-chevron-down text-[10px] text-muted-foreground"></i>
                </button>
                <div class="absolute right-0 mt-2 w-32 rounded-xl border border-border bg-card shadow-lg py-1 z-50 hidden">
                    @foreach ($supportedLocales as $locale)
                        <a
                            href="{{ \Illuminate\Support\Facades\Route::has('lang.switch') ? route('lang.switch', $locale) : '?lang='.$locale }}"
                            class="flex items-center justify-between px-3 py-2 text-xs text-foreground hover:bg-muted transition-colors {{ $locale === $currentLocale ? 'font-bold text-primary bg-primary/10' : '' }}"
                        >
                            <span class="uppercase">{{ $locale }}</span>
                            @if ($locale === $currentLocale)
                                <i class="fa-solid fa-check text-xs text-primary"></i>
                            @endif
                        </a>
                    @endforeach
                </div>
            </div>
        @endif

        {{-- User Menu --}}
        @if ($user)
            <div class="flex items-center gap-2 pl-2 border-l border-border/50">
                <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                    {{ strtoupper(substr($user->name ?? 'A', 0, 1)) }}
                </div>
                <div class="hidden md:flex flex-col text-left">
                    <span class="text-xs font-semibold text-foreground truncate max-w-[120px]">{{ $user->name ?? 'Admin' }}</span>
                    <span class="text-[10px] text-muted-foreground capitalize">{{ method_exists($user, 'getRoleNames') ? ($user->getRoleNames()->first() ?? 'Member') : 'Admin' }}</span>
                </div>
            </div>
        @endif

    </div>
</header>
